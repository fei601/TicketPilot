# ===========================================
# TicketPilot 环境变量配置
# ===========================================
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# LLM 配置（必填）
# 支持 DeepSeek、OpenAI、Qwen 等兼容接口
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Tavily 搜索 API（可选，用于联网搜索演出信息）
TAVILY_API_KEY=your_tavily_api_key_here

# 日志配置
LOG_LEVEL=INFO

# 数据库配置
DATABASE_URL=sqlite:///data/ticketpilot.db
